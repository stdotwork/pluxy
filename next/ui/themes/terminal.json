{
  "theme_version": 0,
  "id": "pluxy/terminal",
  "name": "Terminal",
  "description": "Dark, monospaced and compact, with a narrow navigation rail.",
  "appearance": "dark",
  "tokens": {
    "color.bg": "#0b0f0c",
    "color.surface": "#0f1511",
    "color.surface-raised": "#16201a",
    "color.text": "#c8f0d2",
    "color.text-muted": "#6f9a7b",
    "color.border": "#1f3326",
    "color.accent": "#3ddc84",
    "color.accent-text": "#04140a",
    "color.ok": "#3ddc84",
    "color.warn": "#e5c07b",
    "color.danger": "#ff6b6b",
    "color.focus": "#3ddc84",
    "color.diff-add": "#5cc98a",
    "color.diff-remove": "#ff7b72",
    "color.nav": "var(--px-color-surface)",
    "color.input-border": "var(--px-color-border)",
    "color.nav-selected": "color-mix(in srgb, var(--px-color-accent) 14%, transparent)",
    "font.body": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "font.mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "font.size": "13px",
    "font.size-title": "16px",
    "font.size-mono": "0.95em",
    "font.line-height": "1.45",
    "density": "0.75",
    "size.rail": "40px",
    "size.header": "36px",
    "size.row": "28px",
    "size.row-tall": "36px",
    "size.control": "24px",
    "size.control-main": "28px",
    "shape.radius": "0px",
    "shadow.raised": "none",
    "motion.duration": "0ms",
    "color.card": "transparent",
    "color.card-border": "transparent",
    "color.danger-surface": "transparent",
    "color.warn-surface": "transparent",
    "color.success-surface": "transparent",
    "color.info-surface": "transparent",
    "color.message-action": "var(--px-color-accent)",
    "size.card-padding": "0px",
    "motion.duration-menu": "0ms",
    "motion.duration-slow": "0ms",
    "motion.press-scale": "1",
    "color.message-action-foreground": "var(--px-color-accent-text)"
  },
  "layout": { "frame": "flat", "nav": "rail" },
  "css": "[data-part=\"page-title\"]::before { content: \"$ \"; color: var(--px-color-accent); }"
}
