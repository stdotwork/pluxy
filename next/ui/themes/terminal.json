    "color.border": "#1f3326",
    "color.accent": "#3ddc84",
    "color.accent-text": "#04140a",
    "color.ok": "#3ddc84",
    "color.warn": "#e5c07b",
    "color.danger": "#ff6b6b",
    "color.focus": "#3ddc84",
    "font.body": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "font.size": "13px",
    "font.size-title": "16px",
