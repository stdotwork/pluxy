{
  "theme_version": 0,
  "id": "pluxy/paper",
  "name": "Paper",
  "description": "Warm and roomy, with the navigation on top and lists as cards.",
  "appearance": "both",
  "tokens": {
    "color.bg": "#f6f1e7",
    "color.surface": "#fffdf8",
    "color.surface-raised": "#efe7d8",
    "color.text": "#2b2118",
    "color.text-muted": "#75655a",
    "color.border": "#e3d8c6",
    "color.accent": "#9a3412",
    "color.accent-text": "#ffffff",
    "color.ok": "#1f7a3d",
    "color.warn": "#9a5b00",
    "color.danger": "#b42318",
    "color.focus": "#9a3412",
    "color.diff-add": "#1f7a3d",
    "color.diff-remove": "#b42318",
    "color.nav": "var(--px-color-surface)",
    "color.input-border": "var(--px-color-border)",
    "color.nav-selected": "color-mix(in srgb, var(--px-color-accent) 14%, transparent)",
    "color.card": "var(--px-color-surface)",
    "color.card-border": "var(--px-color-border)",
    "color.danger-surface": "color-mix(in srgb, var(--px-color-danger) 8%, transparent)",
    "color.warn-surface": "color-mix(in srgb, var(--px-color-warn) 8%, transparent)",
    "font.body": "Charter, \"Iowan Old Style\", Georgia, serif",
    "font.mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "font.size": "15px",
    "font.size-title": "24px",
    "font.size-mono": "0.95em",
    "font.line-height": "1.45",
    "density": "1.25",
    "size.header": "52px",
    "size.row": "44px",
    "size.row-tall": "56px",
    "size.control": "36px",
    "size.control-main": "40px",
    "size.card-padding": "calc(var(--px-space-unit) * var(--px-density) * 4)",
    "shape.radius": "10px",
    "shadow.raised": "0 1px 3px rgb(80 50 20 / 0.10)",
    "size.width-narrow": "760px"
  },
  "dark": {
    "color.bg": "#1c1814",
    "color.surface": "#241f1a",
    "color.surface-raised": "#2e2721",
    "color.text": "#efe6d8",
    "color.text-muted": "#a8998a",
    "color.border": "#3a3129",
    "color.accent": "#f0a36b",
    "color.accent-text": "#1c1008",
    "color.ok": "#5cc98a",
    "color.warn": "#e6b450",
    "color.danger": "#ff7b72",
    "color.focus": "#f0a36b",
    "color.diff-add": "#5cc98a",
    "color.diff-remove": "#ff7b72",
    "color.message-action": "var(--px-color-accent)",
    "color.message-action-foreground": "var(--px-color-accent-text)"
  },
  "layout": { "frame": "flat", "nav": "top", "list": "cards", "width": "narrow" }
}
