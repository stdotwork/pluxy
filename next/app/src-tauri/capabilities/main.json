{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The app's own window, and nothing else: every app command and listening for the app's events. Extension page webviews (page-<n>) get no capability.",
  "local": true,
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-startup-get",
    "allow-startup-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-connection-get",
    "allow-connection-set",
    "allow-core-restart",
    "allow-core-call",
    "allow-key-entry",
    "allow-management-key-rotate",
    "allow-sign-out",
    "allow-page-open",
    "allow-page-place",
    "allow-page-close",
    "allow-page-send",
    "allow-confirmation-request",
    "allow-confirmation-settings",
    "allow-device-list",
    "allow-device-registries",
    "allow-device-install",
    "allow-device-install-file",
    "allow-device-enable",
    "allow-device-remove",
    "allow-device-rollback",
    "allow-device-page-open",
    "allow-access-list",
    "allow-access-signer",
    "allow-access-grant",
    "allow-access-revoke",
    "allow-program-call",
    "allow-program-cancel",
    "allow-program-status",
    "allow-window-get",
    "allow-window-set",
    "allow-window-close",
    "allow-privacy-get",
    "allow-privacy-set"
  ]
}
