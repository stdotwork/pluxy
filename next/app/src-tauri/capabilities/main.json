{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The app's own window, and nothing else: every app command and listening for the app's events. Extension page webviews (page-<n>) get no capability.",
  "local": true,
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-startup-get",
    "allow-startup-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-connection-get",
    "allow-connection-set",
    "allow-core-restart",
    "allow-core-call",
    "allow-core-versions",
    "allow-core-install",
    "allow-core-rollback",
    "allow-core-adopt",
    "allow-key-entry",
    "allow-sign-out",
    "allow-page-open",
    "allow-page-place",
    "allow-page-close",
    "allow-page-send",
    "allow-confirmation-request",
    "allow-confirmation-settings",
    "allow-window-get",
    "allow-window-set",
    "allow-window-close"
  ]
}
