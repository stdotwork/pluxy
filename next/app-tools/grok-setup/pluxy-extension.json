                    "maxLength": 4096
                  }
                },
                "additionalProperties": false
              }
            },
            "base_url": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": [
            "set",
            "targets",
            "applied",
            "edited",
            "settings"
          ]
        }
