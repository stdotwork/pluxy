          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
