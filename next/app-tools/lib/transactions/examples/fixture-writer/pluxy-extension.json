{
  "manifest_version": 1,
  "id": "pluxy/fixture-writer",
  "version": "0.1.0",
  "app": {
    "version": 0,
    "tier": "native",
    "host_versions": [0],
    "programs": {
      "linux/amd64": "bin/fixture-writer",
      "linux/arm64": "bin/fixture-writer"
    },
    "operations": [
      {
        "id": "preview",
        "description": "Resolve and pin selected JSON config files or files in selected roots",
        "effect": "read",
        "input_schema": {
          "type": "object",
          "properties": {
            "set": { "type": "string", "minLength": 1, "maxLength": 32 },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "minLength": 1, "maxLength": 4096 },
                  "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
                  "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
                },
                "additionalProperties": false
              }
            }
          },
          "required": ["set", "targets"],
          "additionalProperties": false
        },
        "output_schema": { "type": "object", "required": ["set", "targets", "applied", "edited"] }
      },
      {
        "id": "apply",
        "description": "Set top-level values in the previewed JSON files",
        "effect": "write",
        "input_schema": {
          "type": "object",
          "properties": {
            "set": { "type": "string", "minLength": 1, "maxLength": 32 },
            "targets": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object" } },
            "values": { "type": "object" },
            "crash_after": { "type": "integer", "minimum": 1, "maximum": 8 }
          },
          "required": ["set", "targets", "values"],
          "additionalProperties": false
        },
        "output_schema": { "type": "object", "required": ["outcome", "changed"] }
      },
      {
        "id": "clear",
        "description": "Take the applied values out of the previewed JSON files, keeping later edits",
        "effect": "write",
        "input_schema": {
          "type": "object",
          "properties": {
            "set": { "type": "string", "minLength": 1, "maxLength": 32 },
            "targets": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object" } }
          },
          "required": ["set", "targets"],
          "additionalProperties": false
        },
        "output_schema": { "type": "object", "required": ["outcome", "changed"] }
      },
      {
        "id": "restore",
        "description": "Put the previewed files' original bytes back",
        "effect": "write",
        "input_schema": {
          "type": "object",
          "properties": {
            "set": { "type": "string", "minLength": 1, "maxLength": 32 },
            "targets": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object" } }
          },
          "required": ["set", "targets"],
          "additionalProperties": false
        },
        "output_schema": { "type": "object", "required": ["outcome", "changed"] }
      },
      {
        "id": "status",
        "description": "Show the applied sets and the latest recovery reports",
        "effect": "read",
        "input_schema": { "type": "object", "additionalProperties": false },
        "output_schema": { "type": "object", "required": ["sets", "recovered"] }
      }
    ],
    "state": { "version": 0, "readable_versions": [0] }
  }
}
