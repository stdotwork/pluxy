{
  "manifest_version": 1,
  "id": "pluxy/codex-setup",
  "version": "0.1.0",
  "app": {
    "version": 0,
    "tier": "native",
    "host_versions": [
      0
    ],
    "programs": {
      "linux/amd64": "bin/codex-setup",
      "linux/arm64": "bin/codex-setup"
    },
    "operations": [
      {
        "id": "preview",
        "description": "Pin Codex's config.toml and its model catalog (by default ~/.codex/config.toml and ~/.codex/pluxy-model-catalog.json, or selected files, or files in a selected folder) and read their values back, never the key",
        "effect": "read",
        "input_schema": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "additionalProperties": false
              }
            },
            "base_url": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": [
            "set",
            "targets",
            "applied",
            "edited",
            "settings"
          ]
        }
      },
      {
        "id": "import",
        "description": "Import models from core: the catalog entries the core's served models would get from pluxy's Codex templates, and the models it has no template for. Nothing is written.",
        "effect": "read",
        "input_schema": {
          "type": "object",
          "properties": {
            "models": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "upstream": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "display_name": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "non_codex": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "slug"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "models"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object"
        }
      },
      {
