                  "reasoning": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "enum": [
                        "none",
                        "minimal",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max",
                        "ultra"
                      ]
                    }
