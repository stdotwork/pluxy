                  "default_reasoning": {
                    "type": "string",
                    "enum": [
                      "",
                      "none",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max",
                      "ultra"
                    ]
                  },
                  "input_modalities": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "string",
