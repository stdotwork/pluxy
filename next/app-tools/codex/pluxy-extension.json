                  "minimum": 1,
                  "maximum": 1024
                },
                "model": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 240
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "",
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max",
                    "ultra"
                  ]
                },
                "interrupt": {
                  "type": "boolean"
                }
              },
              "required": [
                "enabled",
                "max_threads",
                "model",
                "effort",
                "interrupt"
              ],
              "additionalProperties": false
