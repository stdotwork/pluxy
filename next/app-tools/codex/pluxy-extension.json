                  "sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 64,
                    "maxLength": 64
                  }
                },
                "required": [
                  "selected",
                  "link",
                  "target",
                  "identity",
                  "sha256"
