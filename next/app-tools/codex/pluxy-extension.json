                    "minLength": 1,
                    "maxLength": 32768
                  }
                },
                "required": [
                  "slug",
                  "display_name",
                  "description",
                  "context_window",
                  "max_context_window",
                  "effective_context_window_percent",
                  "auto_compact_token_limit",
                  "reasoning",
                  "default_reasoning",
                  "input_modalities",
                  "visible",
                  "tool_search"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "targets",
            "base_url",
            "key",
            "model",
            "approval_model",
            "remote_compaction",
