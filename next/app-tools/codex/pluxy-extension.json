                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "link": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 4096
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "link": {
                        "type": [
                          "string",
                          "null"
