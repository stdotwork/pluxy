{
  "manifest_version": 1,
  "id": "pluxy/claude-desktop",
  "version": "0.1.0",
  "app": {
    "version": 0,
    "tier": "native",
    "host_versions": [
      0
    ],
    "programs": {
      "linux/amd64": "bin/claude-desktop",
      "linux/arm64": "bin/claude-desktop"
    },
    "operations": [
      {
        "id": "preview",
        "description": "Pin Claude Desktop's third-party files (claude_desktop_config.json, pluxy's gateway profile in configLibrary and configLibrary/_meta.json) (by default in ~/.config/Claude-3p, or selected files or files in a selected folder) and read their values back, never the key",
        "effect": "read",
        "input_schema": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "additionalProperties": false
              }
            },
            "base_url": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": [
            "set",
            "targets",
            "applied",
            "edited",
            "settings"
          ]
        }
      },
      {
        "id": "folders",
        "description": "Create Claude Desktop's configuration library folder, ~/.config/Claude-3p/configLibrary in the app's home folder (and the folders above it that are missing), with mode 0700, when it does not exist yet; Claude Desktop makes it only once a configuration is saved in its own window",
        "effect": "write",
        "input_schema": {
          "type": "object",
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object"
        }
      },
      {
        "id": "apply",
        "description": "Point Claude Desktop at pluxy's core as its third-party inference gateway: choose third-party mode in claude_desktop_config.json, write the core's address, the client key and the models into pluxy's gateway profile and make it the applied configuration in configLibrary/_meta.json, keeping everything else in the three files. Restart Claude Desktop afterward. Saving replaces the file; an edit made in the same instant by another program may be lost.",
        "effect": "write",
        "secrets": {
          "key": "value"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "selected": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "link": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 4096
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "link": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 41
                      },
                      "root": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 41
                      },
                      "parent": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 41
                      },
                      "file": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 41
                      }
                    },
                    "required": [
                      "link",
                      "parent",
                      "file"
                    ],
                    "additionalProperties": false
                  },
                  "sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 64,
                    "maxLength": 64
                  }
                },
                "required": [
                  "selected",
                  "link",
                  "target",
                  "identity",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "base_url": {
              "type": "string",
              "minLength": 8,
              "maxLength": 2048
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "models": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "alias": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 240
                  },
                  "one_m": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "model",
                  "alias",
                  "one_m"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "targets",
            "base_url",
            "key",
            "models"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object"
        }
      },
      {
