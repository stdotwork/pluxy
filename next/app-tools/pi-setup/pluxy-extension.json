{
  "manifest_version": 1,
  "id": "pluxy/pi-setup",
  "version": "0.1.0",
  "title": "Pi",
  "summary": "Points the Pi coding agent at pluxy with its provider adapter, with a backup to undo it.",
  "kind": "client",
  "app": {
    "version": 0,
    "tier": "native",
    "host_versions": [
      0
    ],
    "programs": {
      "darwin/amd64": "bin/pi-setup",
      "darwin/arm64": "bin/pi-setup",
      "linux/amd64": "bin/pi-setup",
      "linux/arm64": "bin/pi-setup",
      "windows/amd64": "bin/pi-setup.exe"
    },
    "operations": [
      {
        "id": "preview",
        "description": "Pin Pi's three files, cliproxyapi.json, settings.json and cliproxyapi-models.json, in one agent folder (by default ~/.pi/agent, or a selected agent folder, or the three files selected, links followed) and read them back with the state of pluxy's Pi plugin, never the key; files Pi would not take are pinned and reported refused",
        "effect": "read",
        "input_schema": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "additionalProperties": false
              }
            },
            "folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "base_url": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": [
            "set",
            "targets",
            "applied",
            "edited",
            "pi"
          ]
        }
      },
      {
        "id": "apply",
        "description": "Point Pi at pluxy's core: install pluxy's reviewed copy of the CLIProxyAPI provider plugin for Pi in a pluxy-cliproxyapi-provider folder beside the previewed files when it is not there, write the core's address and the client key into cliproxyapi.json, list the plugin in settings.json (instead of an older app's npm copy) with its provider and the model as Pi's defaults, and remove the plugin's model cache, keeping everything else. Saving replaces the file; an edit made in the same instant by another program may be lost.",
        "effect": "write",
        "secrets": {
          "key": "value"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
