                          "null"
                        ],
                        "maxLength": 41
                      },
                      "parent": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 41
                      },
                      "file": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 41
                      }
                    },
                    "required": [
                      "link",
                      "parent",
                      "file"
                    ],
                    "additionalProperties": false
