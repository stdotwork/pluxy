{
  "manifest_version": 1,
  "id": "pluxy/codex-sessions",
  "version": "0.1.0",
  "app": {
    "version": 0,
    "tier": "native",
    "host_versions": [0],
    "programs": {
      "linux/amd64": "bin/codex-sessions",
      "linux/arm64": "bin/codex-sessions"
    },
    "operations": [
      {
        "id": "list",
        "description": "List Codex's local sessions: titles, folders, providers and times, no messages",
        "effect": "read",
        "input_schema": {
          "type": "object",
          "properties": {
            "offset": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": ["codex_home", "databases", "sessions", "total", "offset", "limit", "has_more", "active", "archived", "warnings"]
        }
      },
      {
        "id": "detail",
        "description": "Show one Codex session's messages and statistics",
        "effect": "disclose",
        "input_schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 134 },
            "offset": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": ["id", "title", "stats", "messages", "offset", "total", "next_offset"]
        }
      },
      {
        "id": "settings",
        "description": "Set the Codex home folder the reader reads (empty: the default, ~/.codex)",
        "effect": "write",
        "input_schema": {
          "type": "object",
          "properties": { "codex_home": { "type": "string", "maxLength": 4096 } },
          "required": ["codex_home"],
          "additionalProperties": false
        },
        "output_schema": { "type": "object", "required": ["codex_home", "custom"] }
      }
    ],
    "state": { "version": 0, "readable_versions": [0] },
    "ui": {
      "version": 0,
      "dir": "pages",
      "pages": [{ "id": "sessions", "title": "Codex sessions", "short": "Sessions", "path": "index.html" }]
    }
  }
}
