          "request": {
            "contents": [{"parts":[{"text":"Say hello"}],"role":"user"}],
            "generationConfig": {},
            "sessionId": "-2591501683323337334"
          },
          "requestId": "(volatile)",
          "requestType": "agent",
          "userAgent": "antigravity"
        },
        "headers": {
          "Accept-Encoding": "gzip",
          "Authorization": "Bearer sk-corpus-upstream",
