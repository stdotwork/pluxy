    {
      "body": {
        "response": {
          "candidates": [
            {
              "content": {
                "role": "model",
                "parts": [{"text":"thinking...","thought":true},{"text":"Hello world"}]
              },
              "finishReason": "STOP",
              "index": 0
            }
          ],
          "usageMetadata": {
            "promptTokenCount": 40,
            "cachedContentTokenCount": 8,
            "candidatesTokenCount": 12,
            "thoughtsTokenCount": 20,
            "totalTokenCount": 72
          },
          "modelVersion": "gemini-corpus-upstream",
          "responseId": "resp-corpus"
        },
        "traceId": "trace-corpus"
      }
    }
  ],
  "volatile": ["client.body.created","client.events[*].data.created","upstream[*].body.requestId"],
  "exceptions": [
    {
      "path": "client.body",
      "kind": "intended",
      "reason": "The new core writes a Chat completion from a Gemini reply with only the fields that are set (today's core adds tool_calls null and a non-standard native_finish_reason).",
      "want": {
        "choices": [
          {
            "finish_reason": "stop",
            "index": 0,
            "message": {
              "content": "Hello world",
              "reasoning_content": "thinking...",
              "role": "assistant"
            }
          }
        ],
        "created": "(volatile)",
        "id": "resp-corpus",
        "model": "gemini-corpus-upstream",
        "object": "chat.completion",
        "usage": {
          "completion_tokens": 32,
          "completion_tokens_details": {"reasoning_tokens":20},
          "prompt_tokens": 40,
          "prompt_tokens_details": {"cached_tokens":8},
          "total_tokens": 72
        }
      }
    }
  ],
