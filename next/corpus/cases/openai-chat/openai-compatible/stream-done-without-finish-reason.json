        {"data":{"id":"chatcmpl-corpus","object":"chat.completion.chunk","created":1700000000,"model":"gpt-test-upstream","choices":[{"index":0,"delta":{"content":", world!"},"finish_reason":null}]}},
        {"data":"[DONE]"}
      ]
    }
  ],
  "exceptions": [
    {
      "path": "client.events[3]",
      "kind": "gap",
      "reason": "The old core reports a stream that never carried a finish_reason as an error even when [DONE] arrives; the new core takes [DONE] as the end, sends finish_reason stop and [DONE], so a truncated reply looks complete."
    },
    {
      "path": "client.events[4]",
      "kind": "gap",
      "reason": "Follows from the [DONE] handling above: the new core sends [DONE], the old core does not."
    }
  ],
