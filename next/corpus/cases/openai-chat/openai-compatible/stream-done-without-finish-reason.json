  "source": ["core/sdk/api/handlers/openai/openai_handlers_stream_truncation_test.go"],
  "client": {
    "path": "/v1/chat/completions",
    "body": {"model":"gpt-test","messages":[{"role":"user","content":"Say hello"}],"stream":true}
  },
  "upstream": [
    {
      "sse": [
        {"data":{"id":"chatcmpl-corpus","object":"chat.completion.chunk","created":1700000000,"model":"gpt-test-upstream","choices":[{"index":0,"delta":{"role":"assistant","content":""},"finish_reason":null}]}},
