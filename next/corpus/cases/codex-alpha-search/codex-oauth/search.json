{
  "description": "POST /v1/alpha/search on a ChatGPT subscription: the body goes to the ChatGPT backend's /alpha/search without the prompt cache fields, with Codex's originator and the client's version, user agent and request IDs; the upstream's JSON reply comes back whole.",
  "source": [
    "core/internal/api/server_routes.go",
    "core/sdk/cliproxy/auth/credential_policy.go",
    "core/internal/api/server_codex_search_siwc_test.go"
  ],
  "client": {
    "path": "/v1/alpha/search",
    "headers": {
      "Version": "0.154.0",
      "User-Agent": "codex_cli_rs/0.154.0 (corpus)",
      "Session_id": "sess-corpus",
      "X-Client-Request-Id": "req-corpus"
    },
    "body": {
      "model": "gpt-6.1-sol",
      "query": "corpus search",
      "max_results": 3,
      "id": "conv-corpus",
      "prompt_cache_key": "pck-corpus",
      "prompt_cache_retention": "24h"
    }
  },
  "upstream": [
    {
      "headers": {"Content-Type":"application/json","X-Request-Id":"req_search_corpus"},
      "body": {
        "id": "search_corpus",
        "results": [
          {"title":"Corpus result","url":"https://example.com/corpus","snippet":"A fake hit."}
        ]
      }
    }
  ],
  "recorded_old_core": {
    "client": {
      "body": {
        "id": "search_corpus",
        "results": [
          {"snippet":"A fake hit.","title":"Corpus result","url":"https://example.com/corpus"}
        ]
      },
      "headers": {
        "Access-Control-Allow-Headers": "Authorization, Content-Type, X-Api-Key, X-Goog-Api-Key, Anthropic-Version, Anthropic-Beta",
        "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Expose-Headers": "X-CPA-TRACE-ID, X-CPA-VERSION, X-CPA-COMMIT, X-CPA-BUILD-DATE, X-CPA-SUPPORT-PLUGIN, X-CPA-HOME-VERSION, X-CPA-HOME-BUILD-DATE, X-SERVER-VERSION, X-SERVER-BUILD-DATE, Location, Retry-After, ETag, X-Request-Id, OpenAI-Request-Id",
        "Content-Type": "application/json",
        "X-Cpa-Trace-Id": "(volatile)"
      },
      "status": 200
    },
    "upstream": [
      {
        "body": {"id":"conv-corpus","max_results":3,"model":"gpt-6.1-sol","query":"corpus search"},
        "headers": {
          "Accept": "application/json",
          "Accept-Encoding": "gzip",
          "Authorization": "Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJleHAiOjQxMDI0NDQ4MDAsInN1YiI6ImNvcnB1c3xzay1jb3JwdXMtdXBzdHJlYW0ifQ.corpus",
          "Chatgpt-Account-Id": "acct-sk-corpus-upstream",
          "Content-Type": "application/json",
          "Originator": "codex_cli_rs",
          "Session_id": "sess-corpus",
          "User-Agent": "codex_cli_rs/0.154.0 (corpus)",
          "Version": "0.154.0",
          "X-Client-Request-Id": "req-corpus"
