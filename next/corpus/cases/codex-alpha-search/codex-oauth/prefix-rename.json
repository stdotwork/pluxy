{
  "description": "On a ChatGPT sign-in with a model prefix, today's core sends the body's model as the client wrote it (prefix included); the new core renames it for the account, as routing does for every endpoint call.",
  "source": [
    "core/internal/api/server_routes.go",
    "core/sdk/cliproxy/auth/credential_policy.go",
    "core/internal/api/server_codex_search_siwc_test.go"
  ],
  "client": {
    "path": "/v1/alpha/search",
    "headers": {
      "Version": "0.154.0",
      "User-Agent": "codex_cli_rs/0.154.0 (corpus)",
      "Session_id": "sess-corpus",
      "X-Client-Request-Id": "req-corpus"
    },
    "body": {
      "model": "team/gpt-6.1-sol",
      "query": "corpus search",
      "max_results": 3,
      "id": "conv-corpus",
      "prompt_cache_key": "pck-corpus",
      "prompt_cache_retention": "24h"
    }
  },
  "upstream": [
    {
      "headers": {"Content-Type":"application/json","X-Request-Id":"req_search_corpus"},
      "body": {
        "id": "search_corpus",
        "results": [
          {"title":"Corpus result","url":"https://example.com/corpus","snippet":"A fake hit."}
        ]
      }
    }
  ],
  "old_core": {"account":{"prefix":"team"}},
  "new_core": {"account":{"prefix":"team"}},
  "account_models": ["gpt-6.1-sol"],
  "exceptions": [
    {
      "path": "upstream[0].body.model",
      "kind": "intended",
      "want": "gpt-6.1-sol",
      "reason": "Routing renames the body's model to the account's upstream name for every endpoint call, so a sign-in's search body names the model the account knows; today's core renames it only for an API key and sends a sign-in's body as the client wrote it, prefix included."
    }
  ],
  "recorded_old_core": {
    "client": {
